<?xml version="1.0" encoding="UTF-8"?>
<project name="razrtest" default="package" basedir=".">

    <property name="app.name" value="MyMidlet"/>
    <property name="cldc" location="lib/cldcapi10-2.0.3.jar"/>
    <property name="midp" location="lib/midpapi20-2.0.3.jar"/>
    <property name="emu"  location="lib/microemulator-2.0.4.jar"/>
    <property name="proguard" location="tools/proguard.jar"/>

    <target name="clean">
        <delete dir="build"/>
        <delete dir="dist"/>
    </target>

    <target name="compile">
        <mkdir dir="build/classes"/>
        <javac srcdir="src" destdir="build/classes"
               source="1.3" target="1.1"
               includeantruntime="false">
            <bootclasspath>
                <pathelement location="${cldc}"/>
                <pathelement location="${midp}"/>
            </bootclasspath>
        </javac>
    </target>

    <target name="jar" depends="compile">
        <jar destfile="build/raw.jar" manifest="MANIFEST.MF">
            <fileset dir="build/classes"/>
            <fileset dir="res" erroronmissingdir="false"/>
        </jar>
    </target>

    <target name="package" depends="jar">
        <mkdir dir="dist"/>
        <java jar="${proguard}" fork="true" failonerror="true">
            <arg value="@proguard.pro"/>
        </java>
        <length file="dist/${app.name}.jar" property="jar.size"/>
        <copy file="app.jad.template" tofile="dist/${app.name}.jad" overwrite="true">
            <filterset>
                <filter token="APP_NAME" value="${app.name}"/>
                <filter token="JAR_SIZE" value="${jar.size}"/>
            </filterset>
        </copy>
    </target>

    <target name="run" depends="package">
        <java jar="${emu}" fork="true">
            <arg value="dist/${app.name}.jad"/>
        </java>
    </target>

</project>